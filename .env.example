# ============================================
# LifeOS Landing — Environment Variables
# ============================================
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your real values below
# 3. NEVER commit .env.local to GitHub (it is in .gitignore)
# 4. In Vercel: add these under Project → Settings → Environment Variables
#
# ⚠️  IMPORTANT SECURITY RULES:
#    - VITE_* variables are embedded in the client bundle — visible in browser.
#      Only use them for PUBLIC keys (Supabase anon key is designed to be public).
#    - Secret keys (Resend API key) must NEVER go here.
#      Add them via: supabase secrets set KEY=value
# ============================================

# ── SUPABASE (public — safe to expose) ──────────────────────────────────────
# Found at: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── APP CONFIG ───────────────────────────────────────────────────────────────
VITE_APP_NAME=LifeOS
VITE_APP_URL=https://lifeos.app

# ── SECRETS (server-side only — NEVER put here) ──────────────────────────────
# Resend API Key → add via Supabase CLI:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxx
#
# Allowed origin for Edge Function CORS → add via Supabase CLI:
#   supabase secrets set ALLOWED_ORIGIN=https://lifeos.app
